# Shared secret configured on the GitHub webhook (Settings > Webhooks).
# Used to verify the X-Hub-Signature-256 header on incoming requests.
GITHUB_WEBHOOK_SECRET=changeme

# Redis connection for the job queue (docker-compose up starts a local one).
# If unset, the server falls back to an in-memory stub queue (dev/test only,
# no worker consumes it).
REDIS_URL=redis://localhost:6390/0

# Postgres connection for review history (docker-compose up starts a local
# one). Schema is created automatically on startup if it doesn't exist.
DATABASE_URL=postgresql://ai_reviewer:ai_reviewer@localhost:5442/ai_reviewer

# Also required by the worker (it runs the agent/ pipeline): OPENAI_API_KEY,
# GITHUB_TOKEN. Optional: PINECONE_API_KEY / PINECONE_INDEX_NAME for semantic
# memory, LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT for
# LangSmith tracing (see ../.env.example at the repo root for both).

# Fraction of completed reviews with at least one issue that get sampled for
# online eval (an LLM judge grades each finding's plausibility). Defaults to
# 0.15 if unset.
# ONLINE_EVAL_SAMPLE_RATE=0.15
