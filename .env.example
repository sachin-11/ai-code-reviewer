# Copy this file to .env and fill in real values for local runs.
# In GitHub Actions, these are supplied via secrets and the github context
# instead (see .github/workflows/code-review.yml) — this file is not used in CI.

# API keys
OPENAI_API_KEY=sk-...
GITHUB_TOKEN=ghp_...

# Optional (hosted-service mode only): use a GitHub App instead of the PAT
# above. Once set, GITHUB_TOKEN is no longer required and every GitHub
# API call plus git clone/push uses a per-installation token instead --
# this also fixes the PAT setup's "bot ignores its own comment" collision
# on the fix-PR approve/reject flow, since an App has a genuinely separate
# identity (<slug>[bot]) from any human reviewer. GITHUB_APP_PRIVATE_KEY is
# the downloaded .pem file's content with real newlines replaced by literal
# "\n" (most env-var UIs, Railway included, can't hold a real multi-line
# value cleanly).
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Optional: semantic memory (search_semantic_memory tool). If unset, the
# agent skips this tool gracefully instead of erroring.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=ai-review-memory

# Optional: route the analyze/fix/publish/conversation nodes through a local
# Ollama model instead of OpenAI, at zero API cost. Only OPENAI_API_KEY above
# becomes optional when this is set -- eval/judge.py always uses OpenAI, so
# review quality stays measurable against a fixed reference model regardless
# of which model produced the review.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# Optional: hard cap on a single review's own OpenAI spend (agentic_analyze's
# ReAct loop stops early and reports whatever it has so far once this is
# hit). Defaults to $0.50 if unset -- generous headroom over a typical
# review's real cost, only kicks in for a pathological huge-diff/chatty-loop
# case.
# MAX_COST_PER_REVIEW_USD=0.50

# Optional: LangSmith tracing. Both must be set (and TRACING_V2 must be the
# literal string "true") for OpenAI calls to be wrapped and traced, and for
# LangGraph's own node-level tracing to activate.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ai-code-reviewer

# PR being reviewed
PR_NUMBER=1
PR_HEAD_SHA=headcommitsha
PR_BASE_SHA=basecommitsha
REPO_FULL_NAME=owner/repo
HEAD_BRANCH=feature-branch
BASE_BRANCH=main

# Absolute path to a local git checkout of REPO_FULL_NAME at PR_HEAD_SHA
WORKSPACE=/path/to/local/checkout
